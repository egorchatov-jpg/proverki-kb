# Copy these variables into Timeweb Cloud App Platform -> Environment

# SQLite database (mount persistent volume; path must survive redeploys)
DATABASE_PATH=/var/www/data/proverki.db
BACKUPS_DIR=/var/www/data/backups

# One-time migration from GitHub (optional, run locally before deploy):
#   npm run migrate:from-github

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:egorchatov@gmail.com

# GitHub token — only needed for migrate:from-github script, not for runtime
GITHUB_TOKEN=
GITHUB_OWNER=egorchatov-jpg

PORT=3000
HOST=0.0.0.0
ENABLE_BACKUP_CRON=1
