# Copy these variables into Timeweb Cloud App Platform -> Environment

# Timeweb App Platform: container filesystem is cleared on each redeploy.
# SQLite lives in /tmp during runtime; persistence is via GitHub sync (below).
DATABASE_PATH=/tmp/proverki-kb/proverki.db
BACKUPS_DIR=/tmp/proverki-kb/backups

# GitHub data repo — runtime persistence for SQLite + backups
ENABLE_GITHUB_PERSIST=1
GITHUB_TOKEN=
GITHUB_OWNER=egorchatov-jpg
GITHUB_DATA_REPO=proverki-kb-data

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:egorchatov@gmail.com

PORT=3000
HOST=0.0.0.0
ENABLE_BACKUP_CRON=1
