# Copy to .env.local — local tests on master code, SQLite database.
#
# First-time setup:
#   npm install
#   npm run migrate:from-github-dev   # import prod data into data/proverki-dev.db
#   npm start
#
# Refresh local DB from production GitHub archive:
#   npm run sync:dev-from-prod

GITHUB_TOKEN=
GITHUB_OWNER=egorchatov-jpg

# Local dev database (separate from production Timeweb file)
DATABASE_PATH=data/proverki-dev.db

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:egorchatov@gmail.com

PORT=3000
HOST=0.0.0.0
ENABLE_BACKUP_CRON=0
