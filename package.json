{
  "name": "proverki-kb",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:lan": "node scripts/dev-lan-url.js",
    "setup:dev-data": "node scripts/setup-dev-data-repo.js",
    "migrate:from-github": "node scripts/migrate-github-to-sqlite.js --repo=proverki-kb-data",
    "migrate:from-github-dev": "node scripts/migrate-github-to-sqlite.js --repo=proverki-kb-data-dev --db=data/proverki-dev.db",
    "sync:dev-from-prod": "node scripts/migrate-github-to-sqlite.js --repo=proverki-kb-data --db=data/proverki-dev.db",
    "copy:prod-today": "node scripts/copy-records-to-dev.js",
    "copy:prod-all": "node scripts/copy-records-to-dev.js --all",
    "backup:create": "node scripts/create-backup.js",
    "backup:purge-github-excel": "node scripts/purge-github-excel-backups.js"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "sharp": "^0.35.3",
    "web-push": "3.6.7",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0"
  }
}
